# ==============================================================================
# LabOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Environment
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Authoritative System of Record)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labos_dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Identity & Access Control (OpenID Connect / OAuth2)
# ------------------------------------------------------------------------------
# Keycloak (local dev) or Enterprise IdP (Azure AD / Okta)
OIDC_ISSUER_URL=http://localhost:8080/realms/labos
OIDC_AUDIENCE=labos-api

# ------------------------------------------------------------------------------
# Development & Testing Overrides (STRICTLY PROHIBITED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Allows solo developers to test end-to-end workflows with a single user account
BYPASS_FOUR_EYES_FOR_DEV=false
